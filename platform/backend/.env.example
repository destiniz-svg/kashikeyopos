# ── Railway injects DATABASE_URL from the attached Postgres plugin ──────────
# Owner connection. Used ONLY by migrations and provisioning, never by requests.
DATABASE_URL=postgresql://postgres:pass@host:5432/railway

# Runtime connection template. The server rewrites user+password per outlet,
# so the request path never holds owner credentials.
PGHOST=host
PGPORT=5432
PGDATABASE=railway

# Per-outlet role passwords are DERIVED, never stored:
#   password = hex(hmac_sha256(OUTLET_ROLE_SECRET, "outlet:" + id))
# Rotate by changing this and re-running provision:outlet for every outlet.
OUTLET_ROLE_SECRET=change-me-32-bytes-min

# Session token signing. Separate secret so a leaked token secret cannot mint
# database credentials.
SESSION_SECRET=change-me-too-32-bytes-min
SESSION_TTL_HOURS=12

# Group consolidation role (rank 5 only, read-only, reporting views only).
REPORT_ROLE_PASSWORD=change-me-report

# Comma-separated origins allowed to call the API (the POS and guest portals).
ALLOWED_ORIGINS=https://pos.kashikeyo.mv,https://order.kashikeyo.mv

PORT=8080
NODE_ENV=production
