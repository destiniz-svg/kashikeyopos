# ── Railway injects DATABASE_URL from the attached Postgres plugin ──────────
# Owner connection. Migrations and provisioning ONLY — routes.js does not
# import it, and the leak test asserts an outlet role cannot reach what it can.
DATABASE_URL=postgresql://postgres:pass@host:5432/railway

# Runtime connection template. The server rewrites user+password per outlet, so
# the request path never holds owner credentials.
PGHOST=host
PGPORT=5432
PGDATABASE=railway

# Per-outlet role passwords are DERIVED, never stored:
#   password = hex(hmac_sha256(OUTLET_ROLE_SECRET, "outlet:" + id))
# Rotate by changing this and re-running provision:outlet for every outlet.
OUTLET_ROLE_SECRET=change-me-32-bytes-min

# Session token signing. Separate from the database secret so a leaked token
# secret cannot mint database credentials.
SESSION_SECRET=change-me-too-32-bytes-min
SESSION_TTL_HOURS=12

# Keys the fast PIN lookup (see migration 007). Held here and never in the
# database, so reading every staff row still gives no way to test a PIN
# offline. Rotating it invalidates every lookup and requires re-seeding PINs,
# which is why it is separate from SESSION_SECRET; falls back to it if unset.
PIN_PEPPER=change-me-pin-pepper-32-bytes-min

# Group consolidation role: rank 5, read-only, the aggregate function only.
REPORT_ROLE_PASSWORD=change-me-report

# Comma-separated origins allowed to call the API. Till origins and guest
# origins are listed separately so a guest page cannot reach a till endpoint.
ALLOWED_ORIGINS=https://pos.kashikeyo.mv,https://order.kashikeyo.mv

PORT=8080
NODE_ENV=production

# ── The member portal (04-MEMBER-PORTAL-SPEC.md) ────────────────────────────
# `kashikeyo_member` is the third database role: chain-wide, a SELECT on six
# chain tables, and no grant on any outlet schema. Its password is DERIVED from
# OUTLET_ROLE_SECRET above — there is deliberately no variable for it, because a
# password somebody has to set is a password that can be set weakly, forgotten
# at a redeploy, or pasted into a chat.
#
# Sign-in is by one-time code. With no gateway configured the portal SAYS so and
# a cashier signs the member in at the counter instead; it does not pretend to
# send. The gateway is any endpoint that accepts {to, text} as JSON.
SMS_WEBHOOK_URL=
SMS_API_KEY=
# How long a member stays signed in. A loyalty card is not a banking app; 30
# days is the default and this overrides it in hours.
MEMBER_TTL_HOURS=720
# How long a redeemed voucher is good for, in days. 0 means it never expires.
VOUCHER_DAYS=90
