{
  "name": "kashikeyo-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "migrate": "node scripts/migrate.js",
    "provision:outlet": "node scripts/provision-outlet.js",
    "seed:staff": "node scripts/seed-staff.js",
    "leak-test": "node scripts/leak-test.js",
    "test:unit": "node --test ../packages/money/*.test.js",
    "test:integration": "node --test --test-concurrency=1 test/*.test.js",
    "test": "npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.12.0"
  }
}