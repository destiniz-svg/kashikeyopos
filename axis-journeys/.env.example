# Axis Journeys — environment.
# Nothing in the application reads process.env directly; src/lib/config.ts is the one reader, and
# a production boot refuses to start when a required value is missing (see `configFaults()`).
# Never commit real values. Deployed secrets live in AWS Secrets Manager / Wrangler secrets.

# ---------------------------------------------------------------- identity
APP_STAGE=production                 # development | staging | production
SITE_URL=https://axisjourneys.com    # the canonical origin; every absolute URL derives from it
# API_ORIGIN=https://api.axisjourneys.com   # only when the API is served from its own hostname
# MEDIA_ORIGIN=https://media.axisjourneys.com  # CloudFront/Cloudflare in front of the media bucket

# ---------------------------------------------------------------- data plane (AWS)
STORE_DRIVER=dynamodb                # dynamodb | file  (file is for local development and CI)
DYNAMODB_TABLE=axis-journeys
AWS_REGION=me-central-1
# STORE_DIR=.data                    # file driver only

MEDIA_DRIVER=s3                      # s3 | local
MEDIA_S3_BUCKET=axis-journeys-media
# MEDIA_S3_REGION=me-central-1       # defaults to AWS_REGION
MEDIA_MAX_BYTES=10485760

# Credentials come from the task/instance role in AWS. These are only for local runs against AWS.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ---------------------------------------------------------------- mail (AWS SES)
MAIL_DRIVER=ses                      # ses | log  (log writes the message to the process log)
SES_FROM=no-reply@axisjourneys.com
# SES_REGION=me-central-1
ENQUIRY_NOTIFY_EMAIL=hello@axisjourneys.com   # falls back to the address in Settings

# ---------------------------------------------------------------- bots (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=1                 # 1 in production: an unconfigured check refuses rather than shrugs

# ---------------------------------------------------------------- CMS sessions
SESSION_SECRET=                      # 32+ random characters; rotating it signs everyone out
SESSION_TTL_HOURS=12
# The first owner account, created by `npm run seed` when the workspace has no users at all.
ADMIN_OWNER_EMAIL=
ADMIN_OWNER_PASSWORD=
ADMIN_OWNER_NAME=

# ---------------------------------------------------------------- tuning
BUNDLE_TTL_MS=60000                  # how long the public bundle is held in memory
RATE_LIMIT_SCALE=1                   # multiplies every rate-limit ceiling; the suite raises it
LOG_LEVEL=info                       # debug | info | warn | error
