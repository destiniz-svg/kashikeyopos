{
  "name": "axis-journeys",
  "version": "1.0.0",
  "private": true,
  "description": "Axis Journeys \u2014 production website and Axis CMS (Axis Link LLC-FZ, Dubai)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "seed": "node --env-file-if-exists=.env.local --import ./scripts/register-loader.mjs scripts/seed.ts",
    "test": "node --env-file-if-exists=.env.local --import ./scripts/register-loader.mjs --test test/unit/*.test.ts",
    "test:api": "node --env-file-if-exists=.env.local --import ./scripts/register-loader.mjs --test --test-concurrency=2 --test-timeout=300000 test/api/*.test.ts",
    "test:e2e": "node --env-file-if-exists=.env.local --import ./scripts/register-loader.mjs --test --test-concurrency=2 --test-timeout=300000 test/e2e/*.test.ts",
    "test:all": "npm run test && npm run test:api && npm run test:e2e"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "playwright": "1.62.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
